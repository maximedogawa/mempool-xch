{
  "name": "mempool-xch",
  "version": "0.1.0",
  "private": true,
  "description": "A mempool.space-style explorer for the Chia (XCH) network",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "bun next dev",
    "build": "bun next build",
    "build:sage": "bun run scripts/sage/build.ts",
    "sage:serve": "bun run scripts/sage/serve-snapshot.ts",
    "sage:verify": "bun run scripts/sage/verify-snapshot.ts",
    "start": "bun next start",
    "lint": "bun eslint . --config eslint.config.mjs --max-warnings=0",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test",
    "test:unit": "bun test",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:live": "LIVE=1 playwright test --config playwright.config.ts --grep @live",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.8",
    "bech32": "^2.0.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.6",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "happy-dom": "^20.14.5",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "sage-app-sdk": "0.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
