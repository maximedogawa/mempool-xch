{
  "manifestVersion": 0,
  "name": "mempoolxch.space",
  "version": "0.9.0",
  "icon": "icons/icon-512.png",
  "entry": "index.html",
  "sageVersion": {
    "min": "0.13.0"
  },
  "author": {
    "name": "mempoolxch.space",
    "avatar": "icons/icon-192.png"
  },
  "permissions": {
    "network": {
      "whitelist": {
        "required": [
          "https://api.coinset.org",
          "wss://api.coinset.org",
          "https://testnet11.api.coinset.org",
          "wss://testnet11.api.coinset.org",
          "https://api.dexie.space",
          "https://icons.dexie.space",
          "https://api.mintgarden.io",
          "https://api.xchandles.com",
          "https://assets.mainnet.mintgarden.io",
          "https://ipfs.mintgarden.io",
          "https://cloudflare-dns.com",
          "https://dns.google",
          "https://get.geojs.io",
          "https://api.gateio.ws",
          "https://www.okx.com",
          "https://api.huobi.pro"
        ],
        "optional": []
      },
      "whitelistByNetwork": {
        "mainnet": {
          "required": [],
          "optional": []
        },
        "testnet11": {
          "required": [],
          "optional": []
        }
      }
    },
    "capabilities": {
      "required": [
        "app.get_info",
        "app.get_capabilities",
        "app.request_capability_grant",
        "app.lifecycle.set_before_stop_listener",
        "app.lifecycle.ready_to_stop",
        "environment.get_network",
        "environment.theme.get_current",
        "environment.theme.css_vars",
        "environment.theme.listen_changed",
        "storage.persistent_webview",
        "app.request_network_whitelist_grant",
        "wallet.get_asset_balance"
      ],
      "optional": [
        "wallet.get_sync_status",
        "wallet.get_pending_transactions",
        "wallet.get_transactions",
        "wallet.get_coins",
        "wallet.get_coins_by_ids",
        "wallet.check_address",
        "wallet.get_xch_usd_price"
      ]
    }
  }
}
