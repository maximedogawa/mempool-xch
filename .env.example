# Copy to .env.local and fill in. Values are intentionally empty.
# NEXT_PUBLIC_* variables are baked into the browser bundle at build time (Docker: build args;
# CI: repository variables), so only ever put publishable values in them.

# --- Build: app identity ---
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_COMMIT_SHA=

# --- Build: feature flags ---
NEXT_PUBLIC_FEATURE_GAMING_TESTNET=

# --- Build: Sage in-app export (set by `bun run build:sage`) ---
SAGE_BUILD=
SAGE_SNAPSHOT_DIR=

# --- Server runtime: the API the browser reads from (mainnet) ---
# Read by the running server and handed to the browser (/runtime-config.js), never baked into the
# bundle. https URLs (plain http only for localhost).
# The main API: a nodexch gateway (e.g. https://api.nodexch.space) or Coinset. Empty: nodexch.space
# with the key below, else Coinset.
API_URL_MAINNET=
# Where reads go while the main API fails (e.g. https://api.coinset.org), called without a key.
# Empty: no automatic fallback.
API_FALLBACK_URL_MAINNET=
# The site's publishable, origin-bound nodexch keys (nxp_...). Never a secret key (nxs_...).
# nodexch.space refuses requests without one: without the mainnet key the site starts on Coinset.
NODEXCH_KEY_MAINNET=
NODEXCH_KEY_TESTNET11=

# --- Server runtime: transaction badge (/api/badge/tx/<id>) ---
# A Coinset-dialect endpoint and its key per network; empty means Coinset.
MEMPOOL_RPC_URL_MAINNET=
MEMPOOL_RPC_KEY_MAINNET=
MEMPOOL_RPC_URL_TESTNET11=
MEMPOOL_RPC_KEY_TESTNET11=

# --- Tests (manual e2e) ---
E2E_PORT=
